# Copy to .env and generate all secrets before starting. Never commit .env.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=8080
FRONTEND_DIR=frontend/dist
RUN_MIGRATIONS=true

# Required: use independent cryptographically random values.
# JWT_SECRET: at least 48 characters. Database passwords: use hex to stay URL-safe.
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=

# Native backend only; docker-compose.yml supplies its internal database URL.
DATABASE_URL=postgresql://spendwise:SET_GENERATED_POSTGRES_PASSWORD@127.0.0.1:5432/spendwise
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30
DATABASE_MAX_CONNECTIONS=10
AUTH_RATE_LIMIT_PER_MINUTE=20
RUST_LOG=backend=info,tower_http=info

# Only for docker-compose.production.yml. APP_ORIGIN is set from DOMAIN there.
# DOMAIN=finance.example.com
# ACME_EMAIL=operator@example.com
